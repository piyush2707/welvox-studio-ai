
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://welvox.github.io/welvox-studio-ai/schemas/production-plan.schema.json",
  "title": "Welvox Studio AI Production Plan",
  "description": "A portable, validated blueprint for an AI-directed video production.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "output",
    "timeline"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "creative_brief"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "creative_brief": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "format"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "format": {
          "type": "string",
          "enum": ["mp4", "mov", "webm"]
        },
        "video_codec": {
          "type": "string"
        },
        "audio_codec": {
          "type": "string"
        },
        "quality": {
          "type": "string",
          "enum": ["draft", "standard", "high", "maximum"]
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "default": []
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "scenes"],
      "properties": {
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve_original": {
          "type": "boolean",
          "default": true
        },
        "music_asset_id": {
          "type": "string"
        },
        "master_volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "uri"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["video", "image", "audio", "font", "model"]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "start_seconds",
        "duration_seconds",
        "layers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "description": {
          "type": "string"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "start_seconds", "duration_seconds"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "footage",
            "image",
            "text",
            "effect",
            "transition",
            "audio",
            "overlay",
            "3d"
          ]
        },
        "asset_id": {
          "type": "string"
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engine": {
          "type": "string",
          "enum": [
            "director",
            "vfx",
            "motion",
            "cinema",
            "captions",
            "audio",
            "3d",
            "reels"
          ]
        },
        "operation": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
